datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CASUAL
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum WorkingRightStatus {
  CITIZEN_OR_PERMANENT_RESIDENT
  STUDENT_VISA
  WORKING_HOLIDAY
}

enum WorkingHoursPolicy {
  POLICY
  CUSTOM
}

enum ShiftStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum TimesheetStatus {
  PENDING
  APPROVED
}

enum LeaveType {
  ANNUAL
  PERSONAL
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCEL_REQUESTED
  CANCELLED
}

// ==========================================
// MODELS
// ==========================================

model Location {
  id          String        @id @default(cuid())
  name        String        @unique // e.g. "Sha Patisserie", "Zushi Bento"
  code        String        @unique // e.g. "SHA", "ZB"
  users       User[]
  shifts      Shift[]
  timeLogs    TimeLog[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model User {
  id              String          @id @default(cuid())
  name            String?
  email           String          @unique
  pinCode         String
  role            Role            @default(STAFF)
  employmentType  EmploymentType?
  annualLeaveHours Decimal @default(0) @db.Decimal(10, 2)
  personalLeaveHours Decimal @default(0) @db.Decimal(10, 2)
  leaveRequests LeaveRequest[] @relation("LeaveStaff")
  leaveReviews LeaveRequest[] @relation("LeaveReviewer")
  
  // Account Status & Approval
  status          UserStatus      @default(PENDING)
  isApproved      Boolean         @default(false)
  
  // Contact & MYOB Integration
  contactNumber   String?         @unique // String to handle formatting and country codes
  myobEmployeeId  String?         // Nullable until linked in Admin Profile
  hourlyPayRate   Decimal?        @db.Decimal(10, 2)
  rateLastUpdated DateTime?       @db.Date
  workingRightStatus WorkingRightStatus?
  claimTaxFreeThreshold Boolean?
  workingHoursPolicy WorkingHoursPolicy @default(CUSTOM)
  regularWorkingHours Json?
  
  // Primary Venue
  locationId      String?
  location        Location?       @relation(fields: [locationId], references: [id])
  
  // Timestamps
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  shifts          Shift[]
  timeLogs        TimeLog[]
  rosterShifts    RosterShift[]
  timeEntries     TimeEntry[]

  defaultBreakMinutes Int      @default(30) // Default preset break duration
  timesheets         Timesheet[] @relation("TimesheetStaff")
  timesheetActions   TimesheetAudit[] @relation("TimesheetActor")


}

model LeaveRequest {
  id String @id @default(cuid())
  requestGroupId String?
  userId String
  user User @relation("LeaveStaff", fields: [userId], references: [id], onDelete: Restrict)
  workDate DateTime @db.Date
  type LeaveType
  hours Decimal @db.Decimal(10, 2)
  status LeaveStatus @default(PENDING)
  note String @default("")
  reviewNote String @default("")
  reviewedBy String?
  reviewer User? @relation("LeaveReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, workDate, status])
  @@index([requestGroupId])
  replacesId String?
  @@index ([replacesId])
}

model Shift {
  id                  String       @id @default(uuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Shift Timings
  startTime           DateTime
  endTime             DateTime
  
  // Break Tracking
  startBreak          DateTime?    // Nullable until break starts
  endBreak            DateTime?    // Nullable until break finishes
  presetBreakMinutes  Int          @default(30)
  breakMinutes        Int          @default(0)
  
  // Venue / Location Link
  locationId          String?
  location            Location?    @relation(fields: [locationId], references: [id])
  
  // Details & Reports
  roleTag             String?
  notes               String?
  shiftReport         String?      // Optional end-of-shift report text
  
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  breakApproved       Boolean   @default(false)
  publishedAt         DateTime?    // null = draft, not visible to staff
  timesheet           Timesheet?
}

model TimeLog {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  clockIn   DateTime  @default(now())
  clockOut  DateTime?
  
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  
  lat       Float?
  lng       Float?
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  timesheetId String?
  timesheet   Timesheet? @relation(fields: [timesheetId], references: [id], onDelete: Restrict)

  @@index([userId, clockIn])
}

// Payable periods are separate from TimeLog: manager corrections never rewrite
// the original GPS attendance. Multiple periods preserve unpaid clock-out gaps.
model Timesheet {
  id                 String          @id @default(cuid())
  sourceKey          String          @unique
  shiftId            String?         @unique
  shift              Shift?          @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  userId             String
  user               User            @relation("TimesheetStaff", fields: [userId], references: [id], onDelete: Restrict)
  workDate           DateTime        @db.Date
  site               String
  payablePeriods     Json
  breakMinutes       Int             @default(0)
  reason             String          @default("")
  attendanceStatus   String          @default("UNCLASSIFIED")
  status             TimesheetStatus @default(PENDING)
  approvedAt         DateTime?
  approvedBy         String?
  rateAtApproval     Decimal?        @db.Decimal(10, 2)
  // A snapshot lets payroll reject stale approvals after attendance/roster edits.
  sourceSnapshot     String
  version            Int             @default(1)
  logs               TimeLog[]
  history            TimesheetAudit[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([workDate, status])
}

// Each save/approval/reopening records the resulting values and the real actor.
// Restrict deletes so staff/roster cleanup cannot silently erase payroll history.
model TimesheetAudit {
  id          String    @id @default(cuid())
  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Restrict)
  actorId     String
  actor       User      @relation("TimesheetActor", fields: [actorId], references: [id], onDelete: Restrict)
  action      String
  values      Json
  createdAt   DateTime  @default(now())

  @@index([timesheetId, createdAt])
}

model RosterShift {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  notes     String?
  role      String?  // e.g. "Kitchen", "Floor"
  status    ShiftStatus @default(SCHEDULED)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, startTime, endTime])
} 

model TimeEntry {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clockIn   DateTime  @default(now())
  clockOut  DateTime?
  notes     String?
}                                                              
