datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CASUAL
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum ShiftStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// ==========================================
// MODELS
// ==========================================

model Location {
  id          String        @id @default(cuid())
  name        String        @unique // e.g. "Sha Patisserie", "Zushi Bento"
  code        String        @unique // e.g. "SHA", "ZB"
  users       User[]
  shifts      Shift[]
  timeLogs    TimeLog[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model User {
  id              String          @id @default(cuid())
  name            String?
  email           String          @unique
  pinCode         String
  role            Role            @default(STAFF)
  employmentType  EmploymentType?
  
  // Account Status & Approval
  status          UserStatus      @default(PENDING)
  isApproved      Boolean         @default(false)
  
  // Contact & MYOB Integration
  contactNumber   String?         @unique // String to handle formatting and country codes
  myobEmployeeId  String?         // Nullable until linked in Admin Profile
  
  // Primary Venue
  locationId      String?
  location        Location?       @relation(fields: [locationId], references: [id])
  
  // Timestamps
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  shifts          Shift[]
  timeLogs        TimeLog[]
  rosterShifts    RosterShift[]
  timeEntries     TimeEntry[]

  defaultBreakMinutes Int      @default(30) // Default preset break durationdefaultBreakMinutes Int      @default(30) // Default preset break duration


}

model Shift {
  id                  String       @id @default(uuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Shift Timings
  startTime           DateTime
  endTime             DateTime
  
  // Break Tracking
  startBreak          DateTime?    // Nullable until break starts
  endBreak            DateTime?    // Nullable until break finishes
  presetBreakMinutes  Int          @default(30)
  breakMinutes        Int          @default(0)
  
  // Venue / Location Link
  locationId          String?
  location            Location?    @relation(fields: [locationId], references: [id])
  
  // Details & Reports
  roleTag             String?
  notes               String?
  shiftReport         String?      // Optional end-of-shift report text
  
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  breakApproved       Boolean   @default(false)
}

model TimeLog {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  clockIn   DateTime  @default(now())
  clockOut  DateTime?
  
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  
  lat       Float?
  lng       Float?
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model RosterShift {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  notes     String?
  status    ShiftStatus @default(SCHEDULED)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model TimeEntry {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clockIn   DateTime  @default(now())
  clockOut  DateTime?
  notes     String?
}                                                              
