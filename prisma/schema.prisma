datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CASUAL
}

enum Location {
  Sha
  ZB
}

model User {
  id             String         @id @default(uuid())
  name           String
  email          String         @unique
  role           Role           @default(STAFF)
  employmentType EmploymentType @default(CASUAL)
  location       Location       @default(Sha)
  pinCode        String?
  shifts         Shift[]
  timeLogs       TimeLog[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Shift {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime    DateTime
  endTime      DateTime
  breakMinutes Int       @default(0)
  location     Location  @default(Sha)
  roleTag      String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model TimeLog {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clockIn   DateTime  @default(now())
  clockOut  DateTime?
  location  Location  @default(Sha)
  lat       Float?
  lng       Float?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}