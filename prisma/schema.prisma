datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         Role      @default(STAFF)
  hourlyRate   Float?
  pinCode      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  shifts       Shift[]
  timeLogs     TimeLog[]
}

model Shift {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  startTime DateTime
  endTime   DateTime
  notes     String?
  createdAt DateTime @default(now())
}

model TimeLog {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  clockIn   DateTime
  clockOut  DateTime?
  breakMins Int       @default(0)
  createdAt DateTime  @default(now())
}